@book{murakamiMetalFatigueEffects2019,
  title = {Metal {{Fatigue}}: {{Effects}} of {{Small Defects}} and {{Nonmetallic Inclusions}}},
  shorttitle = {Metal {{Fatigue}}},
  author = {Murakami, Yukitaka},
  date = {2019-06-15},
  eprint = {WZadDwAAQBAJ},
  eprinttype = {googlebooks},
  publisher = {Academic Press},
  abstract = {Metal fatigue is an essential consideration for engineers and researchers looking at factors that cause metals to fail through stress, corrosion, or other processes. Predicting the influence of small defects and non-metallic inclusions on fatigue with any degree of accuracy is a particularly complex part of this. Metal Fatigue: Effects of Small Defects and Nonmetallic Inclusions is the most trusted, detailed and comprehensive guide to this subject available. This expanded second edition introduces highly important emerging topics on metal fatigue, pointing the way for further research and innovation. The methodology is based on important and reliable results and may be usefully applied to other fatigue problems not directly treated in this book. - Demonstrates how to solve a wide range of specialized metal fatigue problems relating to small defects and non-metallic inclusions. - Provides a detailed introduction to fatigue mechanisms and stress concentration. - This edition is expanded to address even more topics, including low cycle fatigue, quality control of fatigue components, and more.},
  isbn = {978-0-12-813877-9},
  langid = {english},
  pagetotal = {760},
  keywords = {Technology & Engineering / Materials Science / General,Technology & Engineering / Mechanical}
}

@article{nemotoMicrostructuralDevelopmentNeutron2000,
  title = {Microstructural Development of Neutron Irradiated {{W}}–{{Re}} Alloys},
  author = {Nemoto, Yoshiyuki and Hasegawa, Akira and Satou, Manabu and Abe, Katsunori},
  date = {2000-12-01},
  journaltitle = {Journal of Nuclear Materials},
  shortjournal = {Journal of Nuclear Materials},
  series = {9th {{Int}}. {{Conf}}. on {{Fusion Reactor Materials}}},
  volume = {283--287},
  pages = {1144--1147},
  issn = {0022-3115},
  doi = {10.1016/S0022-3115(00)00290-7},
  url = {https://www.sciencedirect.com/science/article/pii/S0022311500002907},
  urldate = {2025-07-25},
  abstract = {Tungsten (W) alloys are candidate materials to be used as high-heat-flux materials in fusion reactors. In our previous work, W–26 wt\% Re showed drastic hardening and embrittlement after the neutron irradiation. In this study, to clarify the irradiation hardening and embrittlement behavior of W–26 wt\% Re, from the viewpoint of microstructural development, the microstructure observation of the neutron irradiated W–26 wt\% Re was carried out using transmission electron microscope (TEM). The specimens were irradiated at the materials open test assembly of the fast flux test facility (FFTF/MOTA-2A cycle 11) up to ∼1×1027n/m2, (En{$>$}0.1 MeV). The irradiation temperatures were 646, 679, 792, 873 and 1073 K. In all neutron irradiated W–26 wt\% Re samples, sigma-phase precipitates and chi-phase precipitates were observed, while in the thermally aged specimen, only sigma-phase precipitates were observed. Irradiation effects on microstructural development are discussed.},
  file = {C\:\\Zotero\\storage\\DFSP2CMK\\Nemoto et al. - 2000 - Microstructural development of neutron irradiated W–Re alloys.pdf;C\:\\Zotero\\storage\\WQLT2WC6\\S0022311500002907.html}
}

