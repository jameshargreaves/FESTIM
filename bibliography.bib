@article{noceNeutronicsAssessmentSpatial2023,
  title = {Neutronics {{Assessment}} of the {{Spatial Distributions}} of the {{Nuclear Loads}} on the {{DEMO Divertor ITER-like Targets}}: {{Comparison}} between the {{WCLL}} and {{HCPB Blanket}}},
  shorttitle = {Neutronics {{Assessment}} of the {{Spatial Distributions}} of the {{Nuclear Loads}} on the {{DEMO Divertor ITER-like Targets}}},
  author = {Noce, Simone and Flammini, Davide and Gaudio, Pasqualino and Gelfusa, Michela and Mazzone, Giuseppe and Moro, Fabio and Romanelli, Francesco and Villari, Rosaria and You, Jeong-Ha},
  date = {2023-01},
  journaltitle = {Applied Sciences},
  volume = {13},
  number = {3},
  pages = {1715},
  publisher = {Multidisciplinary Digital Publishing Institute},
  issn = {2076-3417},
  doi = {10.3390/app13031715},
  url = {https://www.mdpi.com/2076-3417/13/3/1715},
  urldate = {2025-10-14},
  abstract = {The Plasma Facing Components (PFCs) of the divertor target contribute to the fundamental functions of heat removal and particle exhaust during fusion operation, being subjected to a very hostile and complex loading environment characterized by intense particles bombardment, high heat fluxes (HHF), varying stresses loads and a significant neutron irradiation. The development of a well-designed divertor target, which represents a crucial step in the realization of DEMO, needs the assessment of all these loads as accurately as possible, to provide pivotal data and indications for the design and structural performance prediction of the PFCs. In a particular way, this study is fully devoted to the comprehension of the distributions on the divertor target of the main nuclear loads due to neutron irradiation, performed for the first time using an extremely detailed approach. This work has been carried-out considering the latest configuration of the DEMO reactor, including the updated design of the divertor and ITER-Like PFCs geometry, varying the blanket layout (Water Cooled Lithium Lead—WCLL and Helium Cooled Pebble Bed—HCPB), thus evaluating the impact of the different blanket concept on the above-mentioned distributions. Neutronics analyses have been performed with MCNP5 Monte Carlo code and JEFF3.3 nuclear data libraries. 3D DEMO MCNP models have been created, focusing in particular on a thorough representation of the divertor and PFCs, allowing for the assessment of the distributions of the main nuclear loads: radiation damage (dpa/FPY), He-production rate (appm/FPY) and nuclear heating density (W/cm3) and total nuclear power deposition (MW). These results are presented by means of 2D maps and plots for each PFCs sub-component both for WCLL and HCPB blanket case: W-monoblocks, Cu-interlayers\textbackslash CuCrZr-pipe and PFC-CB (Cassette Body) supports made of Eurofer steel.},
  langid = {english},
  keywords = {DEMO,divertor,MCNP,neutronics,PFC},
  file = {C:\Zotero\storage\5MLI6QMT\Noce et al. - 2023 - Neutronics Assessment of the Spatial Distributions of the Nuclear Loads on the DEMO Divertor ITER-li.pdf}
}

@article{nogamiImprovementImpactProperties2019,
  title = {Improvement of Impact Properties of Tungsten by Potassium Doping},
  author = {Nogami, Shuhei and Watanabe, Shotaro and Reiser, Jens and Rieth, Michael and Sickinger, Sven and Hasegawa, Akira},
  date = {2019-03-01},
  journaltitle = {Fusion Engineering and Design},
  shortjournal = {Fusion Engineering and Design},
  volume = {140},
  pages = {48--61},
  issn = {0920-3796},
  doi = {10.1016/j.fusengdes.2019.01.130},
  url = {https://www.sciencedirect.com/science/article/pii/S0920379619301486},
  urldate = {2025-06-10},
  abstract = {Low temperature brittleness and high ductile-to-brittle transition temperature (DBTT) are potential drawbacks related to the mechanical properties of tungsten (W) for divertor application in fusion reactors. To improve the mechanical properties of W, potassium (K) doping has been applied as a dispersion-strengthening method. In this paper, the effects of K-doping on the Charpy impact properties of W plate fabricated by powder metallurgy and hot rolling in the as-received condition were investigated. In addition, the correlation among the impact properties, tensile properties, and grain structure and the advantages of K-doped W for divertor application of fusion reactor were discussed.},
  keywords = {Charpy impact property,Dispersion strengthening,Grain refining,Hall-Petch law,Potassium doping,Tungsten},
  file = {C\:\\Zotero\\storage\\XJY8WRRA\\Nogami et al. - 2019 - Improvement of impact properties of tungsten by potassium doping.pdf;C\:\\Zotero\\storage\\2THTAH9Q\\S0920379619301486.html}
}

