@article{kongHeliuminducedHardeningEffect2017,
  title = {Helium-Induced Hardening Effect in Polycrystalline Tungsten},
  author = {Kong, Fanhang and Qu, Miao and Yan, Sha and Zhang, Ailin and Peng, Shixiang and Xue, Jianming and Wang, Yugang},
  date = {2017-09-01},
  journaltitle = {Nuclear Instruments and Methods in Physics Research Section B: Beam Interactions with Materials and Atoms},
  shortjournal = {Nuclear Instruments and Methods in Physics Research Section B: Beam Interactions with Materials and Atoms},
  series = {The 27th {{International Conference}} on {{Atomic Collisions}} in {{Solids}}},
  volume = {406},
  pages = {643--647},
  issn = {0168-583X},
  doi = {10.1016/j.nimb.2017.02.029},
  url = {https://www.sciencedirect.com/science/article/pii/S0168583X17301489},
  urldate = {2025-08-22},
  abstract = {In this paper, helium induced hardening effect of tungsten was investigated. 50keV He2+ ions at fluences vary from 5×1015cm−2 to 5×1017cm−2 were implanted into polycrystalline tungsten at RT to create helium bubble-rich layers near the surface. The microstructure and mechanical properties of the irradiated specimens were studied by TEM and nano-indentor. Helium bubble rich layers are formed in near surface region, and the layers become thicker with the rise of fluences. Helium bubbles in the area of helium concentration peak are found to grow up, while the bubble density is almost unchanged. Obvious hardening effect is induced by helium implantation in tungsten. Micro hardness increases rapidly with the fluence firstly, and more slowly when the fluence is above 5×1016cm−2. The hardening effect of tungsten can be attributed to helium bubbles, which is found to be in agreement with the Bacon-Orowan stress formula. The growing diameter is the major factor rather than helium bubbles density (voids distance) in the process of helium implantation at fluences below 5×1017cm−2.},
  keywords = {Hardening effect,Helium bubble,Polycrystalline tungsten},
  file = {C\:\\Zotero\\storage\\43W7UQ4R\\Kong et al. - 2017 - Helium-induced hardening effect in polycrystalline tungsten.pdf;C\:\\Zotero\\storage\\7JBJT5D8\\S0168583X17301489.html}
}

