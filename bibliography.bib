@article{bobyrDeuteriumRetentionWTa2021,
  title = {Deuterium Retention in {{W-Ta}} Alloys after Low-Temperature Plasma Irradiation and Gas Exposure},
  author = {Bobyr, Nikolay P. and Efimov, Vitaly S. and Khripunov, Boris I. and Kozlov, Dmitriy A. and Mednikov, Artem A.},
  date = {2021-12},
  journaltitle = {Physica Scripta},
  shortjournal = {Phys. Scr.},
  volume = {96},
  number = {12},
  pages = {125633},
  publisher = {IOP Publishing},
  issn = {1402-4896},
  doi = {10.1088/1402-4896/ac3ea4},
  url = {https://dx.doi.org/10.1088/1402-4896/ac3ea4},
  urldate = {2025-08-27},
  abstract = {In this study plates of W, W-xTa alloys (x = 1; 3; 5 concentration in at.\%) with a large grain size were used as experimental samples. All the samples were polished to a mirror surface and outgassed in vacuum at 1100 K during 2 h. Sets of W, W-1Ta, W-3Ta, W-5Ta samples were irradiated with low-temperature D plasma up to fluences of 2e25 D m−2. Other sets of W, W-1Ta, W-3Ta, W-5Ta samples were exposed in D2 gas in a temperature range of 425 ÷ 625 K and pressure 103 Pa. The D retention in W and W-Ta alloys was measured by thermal desorption spectroscopy (TDS). An influence of Ta dopant on deuterium retention in W was observed. The dopant of tantalum slightly reduces the accumulation of deuterium in tungsten during gas exposure. Increasing temperature of samples during D-plasma irradiation from 415 K to 615 K reduces deuterium retention up to 2 orders of magnitude.},
  langid = {english},
  file = {C:\Zotero\storage\Z69QVBZ2\Bobyr et al. - 2021 - Deuterium retention in W-Ta alloys after low-temperature plasma irradiation and gas exposure.pdf}
}

@article{bokhonovGraphitizationSyntheticDiamond2021,
  title = {Graphitization of Synthetic Diamond Crystals: {{A}} Morphological Study},
  shorttitle = {Graphitization of Synthetic Diamond Crystals},
  author = {Bokhonov, Boris B. and Dudina, Dina V. and Sharafutdinov, Marat R.},
  date = {2021-10-01},
  journaltitle = {Diamond and Related Materials},
  shortjournal = {Diamond and Related Materials},
  volume = {118},
  pages = {108563},
  issn = {0925-9635},
  doi = {10.1016/j.diamond.2021.108563},
  url = {https://www.sciencedirect.com/science/article/pii/S0925963521003265},
  urldate = {2025-04-30},
  abstract = {In the present work, the morphological and structural evolution occurring upon graphitization of synthetic diamond microcrystals of cuboctahedral shape at 1600~°C during vacuum annealing was studied. The most developed facets of the initial diamond crystals are octahedral \{111\} and cube \{100\} facets. It was found that graphitization starts from the vertices and edges of the crystals. The \{111\} facets were more prone to graphitization than the \{100\} facets. Annealing of the partially graphitized diamond microcrystals in air helped revealing the orientation relationship of the forming graphite platelets with the parent diamond substrate. The graphite structures forming upon full graphitization of the diamond microcrystals retained the shape of the initial crystals.},
  keywords = {Annealing,Facet,Graphitization,Morphology,Synthetic diamond microcrystals},
  file = {C:\Zotero\storage\WIUZIXN3\S0925963521003265.html}
}

