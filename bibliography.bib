@article{abernethyPredictingPerformanceTungsten2017,
  title = {Predicting the Performance of Tungsten in a Fusion Environment: {{A}} Literature Review},
  shorttitle = {Predicting the Performance of Tungsten in a Fusion Environment},
  author = {Abernethy, R.G.},
  date = {2017-03-01},
  journaltitle = {Materials Science and Technology},
  volume = {33},
  number = {4},
  pages = {388--399},
  publisher = {SAGE Publications},
  issn = {0267-0836},
  doi = {10.1080/02670836.2016.1185260},
  url = {https://journals.sagepub.com/action/showAbstract},
  urldate = {2025-04-14},
  abstract = {Tungsten has been proposed for use in the divertor of future fusion devices. In this environment, it will be exposed to high heat fluxes, neutron damage and hydrogen and helium implantation. This review covers previous experimental and modelling work to establish our ability to predict the performance of tungsten in a fusion environment. Surrogates for high-energy neutrons have been used to predict the change in mechanical properties of tungsten, including fission neutron and self-ion exposure. These studies are critically analysed, with a focus on the difference in results from neutron and ion studies. Further studies to improve our ability to predict the performance of tungsten are proposed as a critical part of the path towards a working fusion reactor. This review was submitted as part of the 2016 Materials Literature Review Prize of the Institute of Materials, Minerals and Mining run by the Editorial Board of MST. Sponsorship of the prize by TWI Ltd is gratefully acknowledged},
  langid = {english},
  file = {C:\Zotero\storage\CR8HEQTH\Abernethy - 2017 - Predicting the performance of tungsten in a fusion environment A literature review.pdf}
}

