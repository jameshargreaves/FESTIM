  issn = {2352-4928},
  doi = {10.1016/j.mtcomm.2025.112002},
  url = {https://www.sciencedirect.com/science/article/pii/S2352492825005148},
  urldate = {2025-08-07},
  abstract = {Nuclear fusion energy has been reckoned as a key solution to addressing global energy and environmental challenges. However, pure tungsten (PW), as the most promising plasma-facing materials (PFMs) is unsuitable for application in the future fusion reactors with more demanding environment due to its low recrystallization temperature (RCT), high ductile-to-brittle transition temperature (DBTT), and high irradiation-induced embrittlement susceptibility. This paper reviews the damage mechanisms of PW and the trending W-based candidate PFMs under helium ion (He+) irradiation, focusing on He bubble formation and irradiation-induced microstructural evolution. It also provides a comprehensive assessment of recent advances and challenges in improving the irradiation resistance of W-based materials. This review aims to guide future research on W-based materials under He+ irradiation conditions.},
  keywords = {He ion irradiation,Morphology,Nuclear fusion,W-based PFM},
  file = {C:\Zotero\storage\YZ5G6E9D\S2352492825005148.html}
}

@article{liangMicrostructureEvolutionProperties2024,
  title = {Microstructure Evolution and Properties of Hot Rolling {{K-doped}} Tungsten Sheets},
  author = {Liang, Mengxia and Yan, Binyou and Song, Jiupeng and Dai, Shaowei and Ren, Ping and Lian, Youyun and Feng, Fan and Wang, Jianbao and Liu, Xiang and Wan, Weicai},
  date = {2024-04-01},
  journaltitle = {International Journal of Refractory Metals and Hard Materials},
  shortjournal = {International Journal of Refractory Metals and Hard Materials},
  volume = {120},
  pages = {106594},
  issn = {0263-4368},
  doi = {10.1016/j.ijrmhm.2024.106594},
  url = {https://www.sciencedirect.com/science/article/pii/S0263436824000428},
  urldate = {2025-07-25},
  abstract = {Potassium-doped tungsten (AKS-W) is a promising plasma-facing material (PFM) in nuclear reactor applications, whereas its up-scaling manufacturing poses a challenge. In this study, large-scale AKS-W sheets with 85~ppm potassium (K) dopant were manufactured by powder metallurgy and hot rolling through a mass production route in the real industry to investigate the evolution of K-bubbles and microstructure and their effects on the properties of W. Compared with pure tungsten (PW) sheet counterparts, the AKS-W sheets showed compatible densification and thermal conductivity at room temperature. Doping with K led to an evident hardness increase both in the sintered and deformed states, which was owing to microstructure refining caused by the pinning effect of K on the grain boundaries and dislocations during sintering and thermomechanical deformation. K-bubble evolution mechanisms of AKS-W blocks during sintering and dynamic break-up of K-ellipsoids during hot-rolling were discussed.},
  keywords = {Hot rolling,Microstructure,Potassium bubble evolution,Potassium doping,Tungsten},
  file = {C\:\\Zotero\\storage\\MG6247D2\\Liang et al. - 2024 - Microstructure evolution and properties of hot rolling K-doped tungsten sheets.pdf;C\:\\Zotero\\storage\\GNU3MJIL\\S0263436824000428.html}
}

