@article{yangTungstenPotassiumPromising2019,
  title = {Tungsten–Potassium: A Promising Plasma-Facing Material},
  shorttitle = {Tungsten–Potassium},
  author = {Yang, Xiaoliang and Qiu, Wenbin and Chen, Longqing and Tang, Jun},
  date = {2019-06-01},
  journaltitle = {Tungsten},
  shortjournal = {Tungsten},
  volume = {1},
  number = {2},
  pages = {141--158},
  issn = {2661-8036},
  doi = {10.1007/s42864-019-00018-5},
  url = {https://doi.org/10.1007/s42864-019-00018-5},
  urldate = {2025-06-10},
  abstract = {Tungsten–potassium (potassium-doped tungsten or WK), initially known from the electric filament industry, is a promising plasma-facing material (PFM) in future fusion facilities like International Thermonuclear Experimental Reactor (ITER). However, the brittle nature of W and irradiation-induced defects of WK materials may result in a risk of deuterium–tritium reaction failure in fusion reactors. Previous studies revealed that advanced W with ultrafine grains and nanostructures might be able to address these problems. However, K-doped W, a rapidly developed material for PFMs, lacks a systematical summary. In this review, we firstly describe the powder metallurgy and plastic deformation for the preparation of WK. Then, the mechanical properties of WK and thermal shock resistance results are reviewed. Important issues such as irradiation damages from neutron, heavy ion, and plasma (H isotope or He) irradiation are also discussed. Hitherto, WK under irradiations shows comparable or even better performances compared with other counterparts such as ITER grade pure tungsten. This review could be benefitial to the future efforts of improving the ductility and irradiation tolerance of WK materials.},
  langid = {english},
  keywords = {High Temperature Plasma,Irradiation damage,ITER,Laser-produced Plasma,Low Temperature Plasma,Mechanical property,Nuclear Fission,Plasma-facing materials,Potassium,Thermal shock,Tokamaks,Tungsten–potassium},
  file = {C:\Zotero\storage\EVPM2JA5\Yang et al. - 2019 - Tungsten–potassium a promising plasma-facing material.pdf}
}

