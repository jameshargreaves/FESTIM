@article{roedigInvestigationTungstenAlloys2002,
  title = {Investigation of Tungsten Alloys as Plasma Facing Materials for the {{ITER}} Divertor},
  author = {Roedig, M. and Kuehnlein, W. and Linke, J. and Merola, M. and Rigal, E. and Schedler, B. and Visca, E.},
  date = {2002-11-01},
  journaltitle = {Fusion Engineering and Design},
  shortjournal = {Fusion Engineering and Design},
  volume = {61--62},
  pages = {135--140},
  issn = {0920-3796},
  doi = {10.1016/S0920-3796(02)00113-8},
  url = {https://www.sciencedirect.com/science/article/pii/S0920379602001138},
  urldate = {2025-08-04},
  abstract = {Thermal fatigue experiments on tungsten mock-ups have been carried out by an electron beam facility. Different designs of W monoblock mock-ups as well as a W macrobrush mock-up showed very good performance at maximum power densities between 14 and 20 MW/m2 (absorbed). For two plasma-sprayed tungsten mock-ups, failure limits were reached at 6.5 MW/m2. But from the test results, it can be concluded that these failure limits could be increased by improvement of the production methods. Vertical displacement event (VDE) simulation experiments followed by a thermal fatigue test were performed on a tungsten macrobrush mock-up. No indication of failure was observed from the macroscopic inspections or from the infrared images. But in the metallographic inspection, some cracks were observed at the interface between the tungsten teeth and the soft copper layer.},
  file = {C\:\\Zotero\\storage\\3HTFRQAH\\Roedig et al. - 2002 - Investigation of tungsten alloys as plasma facing materials for the ITER divertor.pdf;C\:\\Zotero\\storage\\LFN6Q4KC\\S0920379602001138.html}
}

