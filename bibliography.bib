@article{terentyevComparativeStudyITER2024,
  title = {Comparative Study of {{ITER}} Conform Tungsten Grades Exposed to High Heat Flux and Neutron Irradiation Damage},
  author = {Terentyev, D. and Wirtz, M. and Morgan, T. W. and Nozawa, T. and Zinovev, A. and Chang, C. C. and Poleshchuk, K. and Elenbaas, J.},
  date = {2024-03-01},
  journaltitle = {Fusion Engineering and Design},
  shortjournal = {Fusion Engineering and Design},
  volume = {200},
  pages = {114200},
  issn = {0920-3796},
  doi = {10.1016/j.fusengdes.2024.114200},
  url = {https://www.sciencedirect.com/science/article/pii/S0920379624000541},
  urldate = {2025-04-14},
  abstract = {Tungsten is plasma-facing material (PFM) for the divertor and test blanket module to be deployed in ITER. During operation, sub-components made of tungsten will be subjected to cyclic heat exposure, plasma particles loads and bombardment by fast neutrons. The optimization of tungsten grades, in terms of mechanical properties, hopefully offering enhanced resistance against high heat flux and irradiation damage is ongoing, and recently A.L.M.T. has proposed an extra cross-rolling step for the industrial fabrication of thick tungsten plates. Here, we present the results of recent experiments aimed at characterizing the impact of high flux plasma load, thermal shock and neutron irradiation on the damage induced in newly released grades and conventional ITER specification tungsten. The assessment included the tensile mechanical properties before and after the irradiation as well as microstructural investigation of surface modification due to the high heat flux testing. The neutron irradiation and high heat flux tests were performed in a wide range of temperatures (400 - 1200 °C) and covered typical exposure conditions that will be met by PFM in the ITER divertor.},
  keywords = {High heat flux,Irradiation,Thermal shock,Tungsten},
  file = {C:\Zotero\storage\C4LDTKNL\S0920379624000541.html}
}

@article{terentyevMechanicalPropertiesAsfabricated2017,
  title = {Mechanical Properties of As-Fabricated and 2300 ~ °{{C}} Annealed Tungsten Wire Tested up to 600 ~ °{{C}}},
  author = {Terentyev, D. and Riesch, J. and Lebediev, S. and Bakaeva, A. and Coenen, J. W.},
  date = {2017-08-01},
  journaltitle = {International Journal of Refractory Metals and Hard Materials},
  shortjournal = {International Journal of Refractory Metals and Hard Materials},
  volume = {66},
  pages = {127--134},
  issn = {0263-4368},
  doi = {10.1016/j.ijrmhm.2017.03.011},
  url = {https://www.sciencedirect.com/science/article/pii/S0263436817300677},
  urldate = {2025-10-29},
  abstract = {Recent efforts dedicated to the mitigation of tungsten brittleness have demonstrated that tungsten fiber-reinforced composites acquire pseudo ductility even at room temperature. Crack extension and fracture process is basically defined by the strength of tungsten fibers. Here, we move forward and report the results of mechanical and microstructural investigation of different grades of W wire with a diameter of 150μm at elevated temperature up to 600°C. The results demonstrated that potassium doping to the wire in the as-fabricated state does not principally change the mechanical response, and the fracture occurs by grain elongation and delamination. Both fracture stress and fracture strain decrease with increasing test temperature. Contrary to the as-fabricated wire, the potassium-doped wire annealed at 2300°C exhibits much lower fracture stress. The fracture mechanism also differs, namely: cleavage below 300°C and ductile necking above. The change in the fracture mechanism is accompanied with a significant increase of the elongation to fracture being \textasciitilde 5\% around 300°C.},
  keywords = {Fiber,Plasticity,Potassium doped,Tungsten},
  file = {C:\Zotero\storage\VYR6FULE\S0263436817300677.html}
}

