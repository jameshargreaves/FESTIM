  author = {Hirai, T and Bondarchuk, E and Borovkov, A I and Koppitz, Th and Linke, J and Mertens, Ph and Neubauer, O and Panin, A and Philipps, V and Pintsuk, G and Sadakov, S and Steinbrech, R W and Schweer, B and Uytdenhouwen, I and Vaen, R and Samm, U and Sievering, R},
