@inproceedings{priorEquipmentIrradiationExperiments1983,
  title = {Equipment for {{Irradiation Experiments}} in the {{Coolant Chemistry}} of the {{AGR}}},
  booktitle = {Irradiation {{Technology}}},
  author = {Prior, H. A. and Harper, A.},
  editor = {family=Hardt, given=Peter, prefix=von der, useprefix=true and Röttger, Heinz},
  date = {1983},
  pages = {509--518},
  publisher = {Springer Netherlands},
  location = {Dordrecht},
  doi = {10.1007/978-94-009-7115-8_41},
  abstract = {The Advanced Gas Cooled Reactor (AGR) utilises carbon dioxide at 41 bar as its primary heat transfer medium. Radiolytic reactions in CO2 produce species responsible for oxidation of the graphite from which the moderator and fuel sleeves are fabricated. In order to attain a satisfactory lifetime for these components, small quantities of carbon monoxide and methane (typically 1–2\% CO and 100–200vpm CH4) are maintained in the bulk coolant to inhibit radiolytic oxidation of the graphite. A consequence of this, however, can be the formation of carbonaceous deposit upon fuel cladding with resultant detrimental effects upon heat transfer from fuel to coolant leading to fuel pin overheating. It is therefore necessary to conduct controlled experiments, under conditions as close as possible to those pertaining in-reactor, to optimise the coolant composition and provide a satisfactory moderator life. At the same time the risk of carbonaceous deposition on the heat transfer surfaces of the fuel pins must be minimised.},
  isbn = {978-94-009-7115-8},
  langid = {english}
}

