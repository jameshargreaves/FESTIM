  author = {Pick, M. A. and Altmann, H. and Ciric, D. and Deksnis, E. B. and Falter, H. D. and Fanthome, J. and Lowry, C. and Massman, P. and Mohanti, R. B. and Peacock, A. T. and Tivey, R. B.},
  date = {1995-04-01},
  journaltitle = {Journal of Nuclear Materials},
  shortjournal = {Journal of Nuclear Materials},
  series = {Plasma-{{Surface Interactions}} in {{Controlled Fusion Devices}}},
  volume = {220--222},
  pages = {595--600},
  issn = {0022-3115},
  doi = {10.1016/0022-3115(94)00547-8},
  url = {https://www.sciencedirect.com/science/article/pii/0022311594005478},
  urldate = {2025-05-01},
  abstract = {The new Mark II divertor of JET is a radical design based on JET experience in designing, installing and operating a variety of x-point energy target plates. It incorporates large inertially cooled carbon fibre reinforced carbon (CFC) tiles (ca. 400 × 180 mm) which are shaped and supported in a way which ensures maximum power handling capability and the elimination of carbon blooms caused by hot spots. The paper reports on the choice of CFC material based on an investigation of a variety of carbon-carbon fibre composite materials undertaken to determine their suitability for the target plates of the JET Mark II divertor. The material properties studied have been thermal conductivity, thermal bowing, mechanical integrity and surface conditioning. Both thermal and mechanical testing were performed upon tile test pieces.},
  file = {C:\Zotero\storage\HVJIB5QN\0022311594005478.html}
}

