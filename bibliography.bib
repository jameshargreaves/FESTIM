@article{yanVacuumDiffusionBonding2019,
  title = {Vacuum Diffusion Bonding {{W}} to {{W-Cu}} Composite: {{Interfacial}} Microstructure and Mechanical Properties},
  shorttitle = {Vacuum Diffusion Bonding {{W}} to {{W-Cu}} Composite},
  author = {Yan, Haixiang and Fan, Jinglian and Han, Yong and Yao, Qing and Liu, Tao and Lv, Yongqi and Zhang, Chenggong},
  date = {2019-07-01},
  journaltitle = {Vacuum},
  shortjournal = {Vacuum},
  volume = {165},
  pages = {19--25},
  issn = {0042-207X},
  doi = {10.1016/j.vacuum.2019.03.060},
  url = {https://www.sciencedirect.com/science/article/pii/S0042207X19302982},
  urldate = {2025-08-04},
  abstract = {W and W-10\,wt\% Cu (W-10Cu) were joined by diffusion bonding with an Fe-Ni-Cu interlayer in a vacuum of 10−3\,Pa. The effects of the bonding temperature (950\,°C, 1000\,°C, 1050\,°C, 1100\,°C, 1150\,°C and 1200\,°C) on the microstructure and corresponding mechanical properties of the diffusion bonded joints were investigated. The maximum average tensile strength for the bonded joints reached 241\,MPa when a processing temperature of 1050\,°C was used. High resolution transmission electron microscopy and a series of microscopic detection observations showed the presence of a typical W-Ni-Fe metallurgical bongding interface. A Cu4Ni phase was formed at the W/Fe-Ni-Cu interface to improve the performance of the W/W-10Cu joints. The fracture mode for the W/W-10Cu joints bonded at 1050\,°C is ductile and brittle. This technique provides an efficient method for bonding W to W-Cu composite.},
  keywords = {Diffusion bonding,Mechanical properties,Metallurgical interface,Vacuum,W/W-10Cu},
  file = {C:\Zotero\storage\8T9JVTRD\S0042207X19302982.html}
}

