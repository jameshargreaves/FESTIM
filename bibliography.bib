@article{singhJoiningWCuCuCrZrCoupon2017,
  title = {Joining of {{WCu-CuCrZr}} Coupon Materials by Diffusion Bonding Technique for Divertor Plasma Facing Components},
  author = {Singh, K. Premjit and Bhavsar, Rushub and Patel, Kaushal and Khirwadkar, S. S. and Patel, Alpesh and Bhope, Kedar},
  date = {2017-10-01},
  journaltitle = {Fusion Engineering and Design},
  shortjournal = {Fusion Engineering and Design},
  volume = {121},
  pages = {272--281},
  issn = {0920-3796},
  doi = {10.1016/j.fusengdes.2017.08.003},
  url = {https://www.sciencedirect.com/science/article/pii/S0920379617307718},
  urldate = {2025-08-04},
  abstract = {Development of a joining technique for the plasma facing components of an ITER-like tokamak is a challenging area in fusion research. These components are expected to withstand the high heat flux of 5 to 10MW/m2. The life of these components is assessed by the quality of the joint. Thereby selection of a suitable joining technique is considered a key role. A diffusion bonding technique was employed for the joining of WCu-CuCrZr material with nickel interlayer and titanium interlayer using a Gleeble 3800 system. Diffusion bonding experiments were performed at various temperatures (600°C, 650°C, 700°C, 750°C, 800°C, 850°C \& 900°C) with the uniaxial pressures of 5MPa, 10MPa and 15MPa and a constant dwell time of 15min. The bonded specimens were characterized using non-destructive testing (ultrasonic examination of diffused region) and destructive testing (shear testing and micro hardness examination). The effect of the test parameters on the bonding strength has been studied and evaluated with respect to various inter-layers. The diffusion bonded joint was qualified for 1000 cycles at 450°C. The details of experimental and characterization results are presented in this paper.},
  keywords = {Diffusion bonding,Gleeble 3800,NDT,Plasma facing component},
  file = {C:\Zotero\storage\QQWXMZZA\S0920379617307718.html}
}

